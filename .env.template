#!/bin/bash
# Environment configuration for nascent-lulcc project
#
# YAML config (config/local_config.yaml | config/hpc_config.yaml) is the
# authoritative path map for the pipeline (D-12, D-13). The variables in
# this file are only the explicit machine-specific overrides that vary by
# host (D-13, D-14). Do not duplicate YAML-resolved paths here.
#
# Copy this file to `.env` and edit values for your machine.

# ---------------------------------------------------------------------------
# Project paths (HPC layout)
# ---------------------------------------------------------------------------
# `$USER` is expanded by the shell so this template works for any operator
# on Euler without manual edits (PIPE-04, D-14).
export NASCENT_LULCC_HOME="/cluster/home/$USER/nascent-lulcc"
export NASCENT_LULCC_SRC="$NASCENT_LULCC_HOME/src"
export NASCENT_LULCC_SCRIPTS="$NASCENT_LULCC_HOME/scripts"
export NASCENT_LULCC_CONFIG="$NASCENT_LULCC_HOME/config"

# ---------------------------------------------------------------------------
# Stage 7 runtime path contract (consumed by src/setup.r:get_stage7_runtime_paths())
# ---------------------------------------------------------------------------
# These five variables are the ONLY machine-specific runtime overrides for
# Stage 7. R code must read them through `get_stage7_runtime_paths()` rather
# than calling `Sys.getenv()` directly, so semantics stay in one place.

# HPC_SCRATCH_ROOT — scratch filesystem root used as `data_basepath` on HPC.
# REQUIRED on HPC; pre-flight will fail clearly if unset (D-15).
export HPC_SCRATCH_ROOT="/cluster/scratch/$USER/nascent-lulcc"

# HPC_TMP_ROOT — per-job temp root on HPC. REQUIRED on HPC (D-15).
export HPC_TMP_ROOT="$HPC_SCRATCH_ROOT/temp"

# TERRA_TEMP — terra::terraOptions(tempdir=...). Use scratch on HPC, leave
# unset on local machines to fall back to `tempdir()` (PIPE-03).
export TERRA_TEMP="$HPC_SCRATCH_ROOT/terra_temp"

# DINAMICA_EGO_8_HOME — Dinamica install directory locally, OR a wrapper /
# SIF image path on HPC. Resolved by `exec_dinamica()` with backend
# selection (D-09). See `docs/MICROMAMBA_SETUP.md` for site-specific values.
export DINAMICA_EGO_8_HOME=""

# DINAMICA_BACKEND — explicit backend hint consumed by `exec_dinamica()`.
# One of "auto" (default), "local", or "hpc" (D-09).
export DINAMICA_BACKEND="auto"

# ---------------------------------------------------------------------------
# Derived data/results/log paths (HPC scratch layout)
# ---------------------------------------------------------------------------
export NASCENT_LULCC_SCRATCH="$HPC_SCRATCH_ROOT"
export NASCENT_LULCC_DATA="$NASCENT_LULCC_SCRATCH/data"
export NASCENT_LULCC_RESULTS="$NASCENT_LULCC_SCRATCH/results"
export NASCENT_LULCC_LOGS="$NASCENT_LULCC_SCRATCH/logs"

# ---------------------------------------------------------------------------
# System paths (use `$USER` for portability)
# ---------------------------------------------------------------------------
export CONDA_ENVS_PATH="/cluster/home/$USER/environments"
export R_LIBS_USER="/cluster/home/$USER/lib/R"
export MAMBA_EXE="/cluster/home/$USER/tools/micromamba"

# ---------------------------------------------------------------------------
# Temporary directories
# ---------------------------------------------------------------------------
export TMPDIR="$HPC_TMP_ROOT"
export R_TMPDIR="$TMPDIR/R"

# ---------------------------------------------------------------------------
# Performance settings
# ---------------------------------------------------------------------------
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export OPENBLAS_NUM_THREADS=${SLURM_CPUS_PER_TASK:-1}
export GDAL_NUM_THREADS=ALL_CPUS
export GDAL_CACHEMAX=8192

# Create necessary directories
mkdir -p "$R_LIBS_USER" "$CONDA_ENVS_PATH"
